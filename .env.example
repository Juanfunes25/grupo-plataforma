# ── Base de datos ───────────────────────────────────────────────────────────
# Con DATABASE_URL usa Supabase/Postgres. SIN ella corre una base embebida local
# (PGlite en ./data) para probar en tu computadora sin instalar nada.
# Supabase → Project Settings → Database → Connection string → "Session pooler" (puerto 5432).
DATABASE_URL=

# ── Seguridad (OBLIGATORIAS en producción) ──────────────────────────────────
# Firma las sesiones. Genera una con:  node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
APP_JWT_SECRET=
# Protege los PIN guardados. Si la cambias, hay que reasignar todos los PIN.
PIN_PEPPER=
SESION_HORAS=12

# ── Opcionales ──────────────────────────────────────────────────────────────
PORT=4300
FRONTEND_ORIGIN=http://localhost:5180
# Solo si más adelante validas contraseñas contra Supabase Auth:
SUPABASE_URL=
SUPABASE_ANON_KEY=
