{
  "name": "grupo-plataforma",
  "version": "0.1.0",
  "private": true,
  "description": "Plataforma unificada del grupo: Italo, Origen, EcoStone y DISERCO",
  "type": "module",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev:api": "npm run dev -w @grupo/api",
    "dev:web": "npm run dev -w @grupo/web",
    "build": "npm run build -w @grupo/web",
    "start": "node apps/api/src/index.js",
    "migrate": "node apps/api/src/db/migrar.js",
    "seed:rinv": "node apps/api/src/db/sembrar-rinv.js",
    "seed:origen": "node apps/api/src/db/sembrar.js origen",
    "test": "npm test -w @grupo/shared && npm test -w @grupo/api",
    "demo": "node apps/api/src/db/demo.js",
    "crear-dueno": "node apps/api/src/db/crear-dueno.js",
    "importar:italo": "node apps/api/src/migracion/italo-facturacion.js"
  }
}